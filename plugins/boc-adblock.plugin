#!name = 中国银行去广告
#!desc = 屏蔽中国银行 App 从 cdn1.mbs.boc.cn 加载的静态广告图片
#!author = aoomee
#!homepage = https://github.com/aoomee/Loon-Adblock-Plugins
#!system = iOS,iPadOS
#!tag = 去广告,中国银行
#!type = normal

[Rewrite]
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/advertType\/.+\.jpg reject-img
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/\/theme\/ reject-img

[Mitm]
hostname = *.mbs.boc.cn
