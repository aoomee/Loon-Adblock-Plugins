#!name = 中国银行去广告
#!desc = 屏蔽中国银行 App 静态广告图片
#!author = 思南
#!homepage = https://github.com/aoomee/Loon-Adblock-Plugins

[Rewrite]
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/advertType\/.+\.jpg reject-dict
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/\/theme\/ reject-dict

[Mitm]
hostname = *.mbs.boc.cn
