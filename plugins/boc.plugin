#!name = 中国银行去广告
#!desc = 屏蔽中国银行 App 从 cdn1.mbs.boc.cn 加载的静态广告图片
#!author = 思南
#!homepage = https://github.com/aoomee/Loon-Adblock-Plugins

[Rewrite]
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/advertType\/.+\.jpg mock-response-body data-type=text data="{}" status-code=200
^https?:\/\/cdn1\.mbs\.boc\.cn\/ubas-mgateway-static\/images\/\/theme\/ mock-response-body data-type=text data="{}" status-code=200

[Mitm]
hostname = *.mbs.boc.cn
