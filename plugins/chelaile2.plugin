#!name = 车来了去广告
#!desc = 屏蔽车来了 App 广告下发接口、营销位、广告图片与第三方广告 SDK
#!author = CaoXiaoMann
#!homepage = https://github.com/aoomee/Loon-Adblock-Plugins
# 适配版本：车来了 7.6.6，2026-11-05 实机抓包验证
#
# 实测流量位 adPosition 对照（flowPos/listByPos 的 query 参数）：
#   22 = 首页营销位：签到 / 邀请好友 / 活动
#   23 = 「我的」页营销位：每日签到 / VIP会员 / 我的零钱
#   29 = 美团权益 banner：image3/qb5ZXXzk.png → quanyi.yh-jiudian.com
#
# 为什么流量位用脚本而不是 reject：
#   车来了响应体包了一层 **YGKJ{...}YGKJ## 外壳。reject 返回 404 空 body，
#   App 解析失败会沿用本地旧缓存，旧缓存里的广告位照样渲染，图片又被拦掉，
#   于是留下灰色空白。脚本返回「合法但 flowList 为空」的配置，App 会用它
#   覆盖缓存，下次启动读到的也是空。
#   装好脚本后卸载重装一次 App，让缓存被洗成空，之后就不再复现。
#
# 域名拦截为全设备生效，会影响其他 App 的激励视频、看广告换权益
[Rule]
# 车来了自有广告、埋点、统计
DOMAIN,ad.chelaile.net.cn,REJECT
DOMAIN,atrace.chelaile.net.cn,REJECT
DOMAIN,logs.chelaile.net.cn,REJECT
# 智能营销素材 CDN（7.6.7 起横幅 bigIcon 走这里，域名级拦截不依赖解密）
DOMAIN-SUFFIX,smartimg.chelaile.net.cn,REJECT
# 亿广广告联盟
DOMAIN-SUFFIX,yg84.com,REJECT
# 穿山甲（字节）广告 SDK
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT
DOMAIN,lf-cdn-tos.bytescm.com,REJECT
DOMAIN,webcast-open.douyin.com,REJECT
# 巨量 / 火山引擎广告 SDK
DOMAIN,mssdk.volces.com,REJECT
DOMAIN,apmplus.volces.com,REJECT
DOMAIN,vod-license-m.volccdn.com,REJECT
# 腾讯广告（广点通）：只挑子域，不整域拦 gdt.qq.com，避免误伤 QQ 体系
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,win.gdt.qq.com,REJECT
DOMAIN,v2mi.gdt.qq.com,REJECT
DOMAIN,c3.gdt.qq.com,REJECT
DOMAIN,v.gdt.qq.com,REJECT
DOMAIN,t.gdt.qq.com,REJECT
DOMAIN,v3.gdt.qq.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,sdkquic.e.qq.com,REJECT
DOMAIN,tdid.m.qq.com,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,adsmind.ugdtimg.com,REJECT
DOMAIN,qzs.gdtimg.com,REJECT
DOMAIN,tencent-ssp.66mobi.com,REJECT
# 百度广告
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
DOMAIN-SUFFIX,pos.baidu.com,REJECT
DOMAIN-SUFFIX,sofire.baidu.com,REJECT
DOMAIN,nadvideo2.baidu.com,REJECT
DOMAIN,feed-image.baidu.com,REJECT
# 百度视频广告的动态 CDN 回源镜像，共用 CDN 池，影响其他 App 可单独删
DOMAIN-SUFFIX,jomoxc.com,REJECT
# 其他广告联盟 / 归因
DOMAIN-SUFFIX,1rtb.com,REJECT
DOMAIN,rtb.julang.taobao.com,REJECT
DOMAIN,qh-material.taobao.com,REJECT
DOMAIN,gungnir.xiaojukeji.com,REJECT
DOMAIN,orzonera.yingt.fun,REJECT
# 推送 SDK 统计上报（不影响离线推送与到站提醒）
DOMAIN,ali-stats.jpush.cn,REJECT
DOMAIN,gd-stats.jpush.cn,REJECT
[Rewrite]
# 广告 SDK 配置、广告任务、激励活动
^https?:\/\/(api|cdn\.api)\.chelaile\.net\.cn\/adpub\/.* reject
^https?:\/\/(api|cdn\.api)\.chelaileapp\.cn\/adpub\/.* reject
^https?:\/\/(api|cdn\.api)\.chelaile\.net\.cn\/encourage\/activity\/control reject
^https?:\/\/(api|cdn\.api)\.chelaileapp\.cn\/encourage\/activity\/control reject
# 「发现」页内容配置（下发聚合栏目，指向 bus-stroll-new 信息流 H5）
# 拦掉后发现页变空白。底部 tab 图标是原生控件，无法移除。
# 若发现其他页面异常，注释掉这两行
^https?:\/\/(api|cdn\.api)\.chelaile\.net\.cn\/content\/agg\/tab\/info reject
^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/ reject
# 运营位信息流
^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/ reject
# VIP 页的广告任务接口
^https?:\/\/www\.chelaile\.net\.cn\/feserver\/vip-page\/api\/adpub\/ reject
# 埋点：UDID 过滤 / 数据分析
^https?:\/\/(api|cdn\.api)\.chelaile(?:app)?(?:\.net)?\.cn\/DataAnalysisInfo\/.* reject
# 活动广告位
^https?:\/\/[^\/]*chelaile\.net\.cn\/goocity\/advert\/.* reject
^https?:\/\/[^\/]*chelaileapp\.cn\/goocity\/advert\/.* reject
# 广告图片：配置已被脚本置空时这些不会触发，作为兜底保留
# pic1 仅 /adv/ 目录是广告，同域其他路径为业务图
^https?:\/\/pic1\.chelaile\.net\.cn\/adv\/.* reject-img
^https?:\/\/image3\.chelaile\.net\.cn\/qb5ZXXzk\.png.* reject-img
^https?:\/\/quanyi\.yh-jiudian\.com\/activity8\/.* reject-img
# VIP 页图片：会让 VIP 页配图加载失败，介意可注释
^https?:\/\/[^\/]*chelaile\.net\.cn\/feserver\/vip-page\/images\/.* reject-img
^https?:\/\/[^\/]*chelaileapp\.cn\/feserver\/vip-page\/images\/.* reject-img
[Script]
# 流量位置空：flowPos/listByPos 与 flowPos/home
# requires-body=1 不能漏，否则脚本拿不到 $response.body 会静默失败
http-response ^https?:\/\/(api|cdn\.api)\.chelaile(?:app)?(?:\.net)?\.cn\/goocity\/flowPos\/(listByPos|home) script-path=https://raw.githubusercontent.com/aoomee/Loon-Adblock-Plugins/refs/heads/main/plugins/CheLaiLe-flowpos.js, requires-body=1, timeout=10
[Mitm]
hostname = api.chelaile.net.cn, cdn.api.chelaile.net.cn, api.chelaileapp.cn, cdn.api.chelaileapp.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, www.chelaile.net.cn, image3.chelaile.net.cn, pic1.chelaile.net.cn, quanyi.yh-jiudian.com
