#!name = 去哪儿配套清理 v1 兼容语法
#!desc = 与新版规则功能相同，二选一。自动加载本仓库在线脚本；不保证移除本地固定界面。
#!author = aoomee
#!homepage = https://github.com/aoomee/Loon-Adblock-Plugins/blob/main/docs/qunar.md
#!tag = 去哪儿,界面清理

[URL Rewrite]
^https?:\/\/homefront\.qunar\.com\/front\/splash\/ad(?:\?|$) reject
^https?:\/\/qde\.qunar\.com\/preload(?:\?|$) reject

[Script]
http-response ^https?:\/\/(?:slugger|minislugger|homefront|homeback|qbi|lang|qde|client)\.qunar\.com\/ script-path=https://raw.githubusercontent.com/aoomee/Loon-Adblock-Plugins/main/scripts/qunar-clean.js,requires-body=true,timeout=10,tag=去哪儿配套清理
generic script-path=https://raw.githubusercontent.com/aoomee/Loon-Adblock-Plugins/main/scripts/qunar-clean.js,tag=去哪儿清理运行状态,timeout=10

[MitM]
hostname = slugger.qunar.com,minislugger.qunar.com,homefront.qunar.com,homeback.qunar.com,qbi.qunar.com,lang.qunar.com,qde.qunar.com,client.qunar.com
